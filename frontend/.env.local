# 本番環境URL
# NEXT_PUBLIC_API_URL=https://web.local.example-dev.com/api/v1
# 開発環境URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_ORGANIZATION_ID=a0718dc5-21f3-44e6-87e9-cc2ae83f3385

# LocalStorage自動保存間隔（ミリ秒）デフォルト: 30000 (30秒)
NEXT_PUBLIC_MAIML_LOCALSTORAGE_AUTOSAVE_INTERVAL=30000

# LocalStorage保存データの有効期限（日数）デフォルト: 7
NEXT_PUBLIC_MAIML_LOCALSTORAGE_RETENTION_DAYS=7

# パスワード有効期限（日数）。パスワード変更後にこの日数後が新しい有効期限として設定される
PASSWORD_EXPIRY_DAYS=30
