# =============================================================================
# mmdpf 環境変数テンプレート - オンプレ環境用
# =============================================================================
#
# 使い方:
#   cp .env.prod.onprem.example .env
#   vi .env  # 各値を実環境に合わせて編集
#
# ※ このファイルをそのまま使用しないでください（パスワード等を必ず変更）
# =============================================================================

# =============================================================================
# アプリケーション設定
# =============================================================================
NODE_ENV=production
IMAGE_TAG=latest

# =============================================================================
# PostgreSQL 設定
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maiml_db
DB_USER=maiml_user
# ⚠️ 必ず強力なパスワードに変更してください
DB_PASSWORD=maiml_user
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# =============================================================================
# Redis 設定
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# ⚠️ 必ず強力なパスワードに変更してください（空の場合は認証なし）
REDIS_PASSWORD=maiml_redis
REDIS_MAXMEMORY=256mb

# =============================================================================
# OpenStack Swift 設定（オンプレ専用）
# =============================================================================
STORAGE_TYPE=swift
SWIFT_AUTH_URL=http://swift:8080/auth/v1.0
SWIFT_ACCOUNT=test
SWIFT_USER=test:tester
# ⚠️ 必ず強力なパスワードに変更してください
SWIFT_PASSWORD=testing
SWIFT_CONTAINER=mmdpf-files
SWIFT_PORT=8080

USE_S3_COMPATIBLE_API=true
S3_ENDPOINT=http://swift:8080
S3_ACCESS_KEY_ID=test:tester
S3_SECRET_ACCESS_KEY=testing
S3_BUCKET_NAME=mmdpf-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Insertion URI スキーム設定（フロントエンド用）
NEXT_PUBLIC_INSERTION_URI_SCHEME=swift
NEXT_PUBLIC_INSERTION_URI_BUCKET=mmdpf-files

# =============================================================================
# JWT / セッション設定
# =============================================================================
# ⚠️ 必ず64文字以上のランダム文字列に変更してください
# 生成コマンド例: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARACTERS_LONG_RANDOM_STRING
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_64_CHARACTERS_LONG_RANDOM_STRING
SESSION_MAX_AGE=86400000

# =============================================================================
# サーバー設定
# =============================================================================
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGIN=https://your-domain.example.com
NEXT_PUBLIC_API_URL=/api/v1
FRONTEND_URL=https://localhost

# =============================================================================
# SSL / nginx 設定（オンプレ専用）
# =============================================================================
# サーバー証明書ディレクトリ（nginx にマウントされる）
# ディレクトリ内に server.crt と server.key が必要
SSL_CERT_DIR=./backend/certs/server

# CA証明書ディレクトリ（クライアント証明書検証用）
# ディレクトリ内に ca.crt が必要
CA_CERT_DIR=./backend/certs/ca

# =============================================================================
# クライアント証明書設定
# =============================================================================
# PKCS#12 証明書のパスワード
CERT_P12_PASSWORD=mmdpf123
# 証明書有効期限（日数）
CERT_VALIDITY_DAYS=365

# =============================================================================
# ログ設定
# =============================================================================
LOG_LEVEL=info
LOG_DIR=/app/logs

# =============================================================================
# メール設定（パスワードリセット等で使用する場合）
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# SMTP_FROM=noreply@example.com

# =============================================================================
# セマンティック検索 / Embedding 設定（オンプレ: Ollama使用）
# =============================================================================
# Embeddingプロバイダー: "ollama"（オンプレ）または "bedrock"（SaaS）
# オンプレ環境では必ず "ollama" を指定すること
EMBEDDING_PROVIDER=ollama

# Ollama APIホストURL（embeddinggemmaモデルを提供するサーバー）
# オンプレ環境: docker-compose.prod.yml の ollama コンテナが起動するため以下の値を使用
# ※ モデルは初回起動時に ollama-init コンテナが自動でダウンロードします
# 開発環境: docker-compose.ollama.yml で管理する Ollama コンテナのURL
#   起動方法: docker compose up -d && docker compose -f docker-compose.ollama.yml up -d
#   接続確認: curl http://localhost:11434/api/tags
OLLAMA_HOST=http://ollama:11434
# 使用するEmbeddingモデル名（768次元）
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

# gpt-oss-20b（クエリ分解サービス）設定
# AWS Bedrockを使ったクエリ分解FastAPIサービス（semantic_search/ollama-server/ai-services/gpt-oss/）
# GPT_OSS_ENABLED=true の場合のみクエリ分解サービスに連携する
# false または未設定の場合はフォールバック動作（元クエリをそのまま4軸全てに使用）
GPT_OSS_ENABLED=false
# 実際のIPアドレス/ホスト名に変更すること（例: http://192.168.1.100:8001）
GPT_OSS_ENDPOINT=http://YOUR_GPT_OSS_SERVER:8001
GPT_OSS_TIMEOUT=60000
GPT_OSS_MAX_RETRIES=3

# =============================================================================
# AWS Bedrock設定（AI機能を使用する場合）
# =============================================================================
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# =============================================================================
# Email Configuration
# =============================================================================
# メール送信制御:
#   - 本番環境 (NODE_ENV=production) では EMAIL_ENABLED に関わらず常に送信
#   - 開発環境では EMAIL_ENABLED=true の場合のみ送信（false の場合はログ出力のみ）
EMAIL_ENABLED=false

# SMTP設定（Outlook / Office 365 の例）
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test_fukuoka@soft-service.co.jp
SMTP_PASSWORD=Test-fukuoka
SMTP_FROM_ADDRESS=test_fukuoka@soft-service.co.jp
SMTP_FROM_NAME=MMDPF System