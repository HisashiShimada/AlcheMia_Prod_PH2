{
  "_comment": "=================================================================",
  "_comment2": "mmdpf ECS タスク定義テンプレート - フロントエンド",
  "_comment3": "=================================================================",
  "_comment4": "使い方:",
  "_comment5": "  1. <PLACEHOLDER> の値を実環境に合わせて置き換えてください",
  "_comment6": "  2. scripts/deploy.aws.sh が自動的にこのファイルを使用します",
  "_comment7": "  3. 手動で登録する場合: aws ecs register-task-definition --cli-input-json file://aws/ecs-task-definition-frontend.json",
  "_comment8": "=================================================================",

  "family": "mmdpf-frontend",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/mmdpf-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/mmdpf-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],

  "_comment_cpu_memory": "CPU/メモリは実際の負荷に応じて調整してください",
  "_comment_cpu_values": "有効なCPU値: 256, 512, 1024, 2048, 4096",
  "_comment_memory_values": "有効なメモリ値: CPUによって異なる（AWSドキュメント参照）",
  "cpu": "512",
  "memory": "1024",

  "containerDefinitions": [
    {
      "name": "mmdpf-frontend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/mmdpf-frontend:<IMAGE_TAG>",

      "_comment_essential": "必須コンテナ - このコンテナが停止するとタスク全体が停止",
      "essential": true,

      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],

      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "NEXT_TELEMETRY_DISABLED", "value": "1" },
        { "name": "PORT", "value": "3000" },
        {
          "_comment_api_url": "ALBのDNS名またはカスタムドメインを設定",
          "name": "NEXT_PUBLIC_API_BASE_URL",
          "value": "https://<ALB_DNS_NAME>"
        }
      ],

      "_comment_secrets": "機密情報はAWS Secrets Manager から取得することを推奨",
      "secrets": [],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mmdpf-frontend",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/ || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },

      "readonlyRootFilesystem": false,

      "_comment_ulimits": "Node.jsのファイルディスクリプタ上限を引き上げ",
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ]
    }
  ],

  "_comment_tags": "タグはコスト管理・リソース管理に使用",
  "tags": [
    { "key": "Project", "value": "mmdpf" },
    { "key": "Environment", "value": "production" },
    { "key": "Service", "value": "frontend" }
  ]
}
