# =============================================================================
# mmdpf 環境変数テンプレート - SaaS版 AWS環境用
# （ECS Fargate + Aurora + ElastiCache + S3 + Bedrock）
# =============================================================================
#
# 使い方:
#   cp .env.prod.aws.example .env
#   vi .env  # 各値を実環境に合わせて編集
#
# ※ このファイルをそのまま使用しないでください（パスワード等を必ず変更）
# ※ 本番環境では AWS Secrets Manager の使用を強く推奨します
# =============================================================================

# =============================================================================
# アプリケーション設定
# =============================================================================
NODE_ENV=production
IMAGE_TAG=latest

# =============================================================================
# PostgreSQL 設定（AWS Aurora PostgreSQL）
# =============================================================================
# Aurora クラスターエンドポイントを設定してください（書き込みエンドポイント）
# 例: mydb.cluster-xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_HOST=YOUR_AURORA_ENDPOINT.cluster-xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=maiml_db
DB_USER=maiml_user
# ⚠️ 必ず強力なパスワードに変更してください
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Aurora ではSSL接続を必須とします
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=20

# =============================================================================
# Redis 設定（AWS ElastiCache for Redis）
# =============================================================================
# ElastiCache エンドポイントを設定してください
# 例: myredis.xxxxxx.ng.0001.apne1.cache.amazonaws.com
REDIS_HOST=YOUR_ELASTICACHE_ENDPOINT.xxxxxx.ng.0001.apne1.cache.amazonaws.com
REDIS_PORT=6379
# ElastiCache の認証トークン（設定している場合）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=256mb

# =============================================================================
# AWS S3 設定（Swift の代替）
# =============================================================================
STORAGE_TYPE=s3
AWS_S3_BUCKET=mmdpf-files-production
AWS_REGION=ap-northeast-1
# ECS Task Role（IAMロール）を使用する場合は不要（推奨）
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# =============================================================================
# セマンティック検索 / Embedding 設定（SaaS: Bedrock使用）
# =============================================================================
# Embeddingプロバイダー: "bedrock"（SaaS）または "ollama"（オンプレ）
EMBEDDING_PROVIDER=bedrock

# =============================================================================
# AWS Bedrock 設定（Ollama の代替）
# =============================================================================
# Bedrock を利用するリージョン（モデルが利用可能なリージョンを指定）
BEDROCK_REGION=ap-northeast-1
# Embeddingモデル ID（Bedrock で利用するモデル）
# cohere.embed-v4:0 を使用（1024次元、search_document/search_query input_type対応）
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
# Cohereの出力次元数（cohere.embed-v4:0 は 1024次元）
BEDROCK_EMBEDDING_OUTPUT_DIMENSION=1024
# テキスト生成モデル ID（クエリ分解等で使用）
# 例: anthropic.claude-3-5-sonnet-20241022-v2:0 / amazon.nova-pro-v1:0
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# ECS Task Role に Bedrock 権限が付与されている場合はキー不要（推奨）
# AWS_BEDROCK_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_BEDROCK_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# =============================================================================
# JWT / セッション設定
# =============================================================================
# ⚠️ 必ず64文字以上のランダム文字列に変更してください
# 生成コマンド: openssl rand -hex 64
# 推奨: AWS Secrets Manager から取得
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARACTERS_LONG_RANDOM_STRING
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_64_CHARACTERS_LONG_RANDOM_STRING
SESSION_MAX_AGE=86400000

# =============================================================================
# サーバー設定
# =============================================================================
BACKEND_PORT=3001
FRONTEND_PORT=3000
# ALB の DNS 名またはカスタムドメインを設定
CORS_ORIGIN=https://your-alb-domain.ap-northeast-1.elb.amazonaws.com
FRONTEND_URL=https://your-alb-domain.ap-northeast-1.elb.amazonaws.com

# =============================================================================
# クライアント証明書設定
# =============================================================================
# PKCS#12 証明書のパスワード
CERT_P12_PASSWORD=mmdpf123
# 証明書有効期限（日数）
CERT_VALIDITY_DAYS=365

# =============================================================================
# ログ設定
# =============================================================================
LOG_LEVEL=info
LOG_DIR=/app/logs

# =============================================================================
# AWS ECR 設定（deploy.ecr.sh で使用）
# =============================================================================
AWS_ACCOUNT_ID=137068252939
AWS_ECR_REGION=ap-northeast-1
ECR_REPOSITORY_BACKEND=mmdpf-backend
ECR_REPOSITORY_FRONTEND=mmdpf-frontend
ECR_REPOSITORY_NGINX=mmdpf-nginx

# =============================================================================
# AWS ECS 設定（deploy.ecr.sh で使用）
# =============================================================================
ECS_CLUSTER=alchemia-staging
ECS_SERVICE_BACKEND=alchemia-backend-service
ECS_SERVICE_NGINX=alchemia-nginx-service
ECS_TASK_DEFINITION_BACKEND=alchemia-backend
ECS_TASK_DEFINITION_NGINX=alchemia-nginx

# =============================================================================
# メール設定（パスワードリセット等で使用する場合）
# =============================================================================
# AWS SES を使用する場合
# SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=YOUR_SES_SMTP_USER
# SMTP_PASSWORD=YOUR_SES_SMTP_PASSWORD
# SMTP_FROM=noreply@your-domain.example.com
