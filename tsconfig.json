{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests/e2e/playwright.config.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "backend",
    "dist"
  ]
}
