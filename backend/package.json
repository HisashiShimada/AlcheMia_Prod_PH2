{
  "name": "mmdpf-backend",
  "version": "1.0.0",
  "description": "Multi-Modal Data Platform Backend - Materials Science Experiment Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/(utils|middleware|services)",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "materials-science",
    "experiment-management",
    "maiml",
    "petri-net",
    "multi-tenant"
  ],
  "author": "Development Team",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.2.1",
    "typescript": "^5.9.3",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/client-bedrock-runtime": "^3.948.0",
    "aws-sdk": "^2.1693.0",
    "uuid": "^13.0.0",
    "xml-js": "^1.6.11",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/express-session": "^1.18.2",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^11.0.0",
    "@types/cors": "^2.8.19",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "supertest": "^7.1.4",
    "eslint": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
