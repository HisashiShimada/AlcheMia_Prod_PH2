{
  "name": "mmdpf-backend",
  "version": "1.0.0",
  "description": "Multi-Modal Data Platform Backend - Materials Science Experiment Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/database/migrate.ts",
    "migrate:up": "ts-node src/database/migrate.ts up",
    "migrate:down": "ts-node src/database/migrate.ts down",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/(utils|middleware|services)",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:migrations": "jest --testPathPattern=tests/migrations",
    "test:swift": "ts-node scripts/test-swift-connection.ts",
    "check:env": "ts-node scripts/check-env.ts",
    "setup:swift-folders": "ts-node scripts/setup-swift-folders.ts",
    "generate:server-cert": "ts-node scripts/generate-server-cert.ts",
    "generate:types": "ts-node scripts/generate-types-from-xsd.ts",
    "generate:types:watch": "nodemon --watch reference/schemas --exec npm run generate:types",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "materials-science",
    "experiment-management",
    "maiml",
    "petri-net",
    "multi-tenant"
  ],
  "author": "Development Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.990.0",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@types/archiver": "^7.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.4",
    "@types/pg-promise": "^0.0.28",
    "@xmldom/xmldom": "^0.8.11",
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.70.4",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "fast-xml-parser": "^5.3.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.6",
    "node-cache": "^5.1.2",
    "node-forge": "^1.3.3",
    "nodemailer": "^7.0.12",
    "papaparse": "^5.4.1",
    "pg": "^8.16.3",
    "pg-promise": "^12.6.1",
    "redis": "^4.7.1",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml-js": "^1.6.11",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-redis": "^0.0.23",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.10.2",
    "@types/node-cache": "^4.1.3",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.15.6",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@types/winston": "^2.4.4",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
