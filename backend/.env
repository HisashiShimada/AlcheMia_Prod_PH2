# mmdpf Backend Environment Variables Example
# このファイルをコピーして .env ファイルを作成してください

# Node Environment
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=10.3.3.37
DB_PORT=5434
DB_NAME=maiml_db
DB_USER=maiml_user
DB_PASSWORD=maiml_user

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=your-session-secret-key-here-change-in-production

# Storage Configuration
# ストレージタイプ: 'swift' (開発環境) または 's3' (本番環境)
STORAGE_TYPE=swift

# OpenStack Swift Configuration (サーバー環境)
# サーバーSwift: 10.1.1.219:3002
SWIFT_AUTH_URL=http://10.1.1.219:3002/auth/v1.0
SWIFT_USERNAME=test:tester
SWIFT_PASSWORD=testing
SWIFT_ACCOUNT=test
SWIFT_CONTAINER=mmdpf-files

# S3互換APIモード（Swiftでも使用可能）
USE_S3_COMPATIBLE_API=true
S3_ENDPOINT=http://10.1.1.219:3002
S3_ACCESS_KEY_ID=test:tester
S3_SECRET_ACCESS_KEY=testing
S3_BUCKET_NAME=mmdpf-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AWS S3 Configuration (本番環境)
# STORAGE_TYPE=s3 の場合に使用
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_S3_BUCKET=your-s3-bucket-name

# Email Configuration (将来実装)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@example.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM=noreply@example.com

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# セッションストアタイプ（memory | redis）
SESSION_STORE_TYPE=memory
# SESSION_STORE_TYPE=redis

# セッション有効期限（ミリ秒）
SESSION_MAX_AGE=86400000

# セッションCookie名
SESSION_COOKIE_NAME=mmdpf.sid

# セッションCookieのSecure属性（本番環境ではtrue）
SESSION_COOKIE_SECURE=false

# Redis設定（SESSION_STORE_TYPE=redisの時のみ必要）
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ストレージ容量
MAX_STORAGE_GB_PER_ORG=999.0

# 最大プロジェクト数
MAX_PROJECTS_PER_ORG=999

# JWT設定
# JWT_ACCESS_TOKEN_EXPIRES_IN=900    # 15分（秒）
# JWT_REFRESH_TOKEN_EXPIRES_IN=1800  # 30分（秒）
JWT_ACCESS_TOKEN_EXPIRES_IN=3600   # 1時間（秒）
JWT_REFRESH_TOKEN_EXPIRES_IN=28800 # 8時間（秒）

# ブラックリストクリーンアップ周期（秒）
TOKEN_BLACKLIST_CLEANUP_INTERVAL=1800

# Two-Factor Authentication Configuration
# 0: 常に二段階認証必要
# 1以上: 最終二段階認証から指定日数以内は免除
TWO_FACTOR_AUTH_EXEMPTION_DAYS=30

# ========================================
# クライアント証明書生成設定
# ========================================

# OpenSSL実行ファイルのパス（必須）
OPENSSL_PATH=C:\Program Files\Git\usr\bin\openssl.exe

# CA証明書パス（オプション - デフォルト値で自動解決）
# CA_CERT_PATH=C:\Git\mmdpf\nginx\certs\ca\ca.crt
# CA_KEY_PATH=C:\Git\mmdpf\nginx\certs\ca\ca.key

# PKCS#12パスワード（オプション - デフォルト: mmdpf123）
# CERT_P12_PASSWORD=mmdpf123

# 証明書有効期限（オプション - デフォルト: 365日）
# CERT_VALIDITY_DAYS=365

# Phase2-2: 並列処理最適化（2026-02-18）
# ファイルアップロード並列数（1-20、デフォルト: 5）
# 推奨値:
#  - 開発環境: 5
#  - 本番環境（小規模）: 3-5
#  - 本番環境（大規模）: 5-10
UPLOAD_CONCURRENCY=5
