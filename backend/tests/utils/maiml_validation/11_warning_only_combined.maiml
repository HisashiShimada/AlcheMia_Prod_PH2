<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- ケース11: 複数の「警告のみ」項目が重なったケース
     document id欠落 + creator/vendor/owner/date欠落 + method id欠落
     ※ uuid は含める（project_uuid設定に必須のためlenientでもエラー）
     lenient: 警告のみ → アップロード成功
     strict:  複数エラー → 保存失敗 -->
<maiml version="1.0" xmlns="http://www.maiml.org/schemas">
  <document>
    <!-- id属性が欠落 -->
    <name>複合警告テスト</name>
    <!-- uuid は存在する（必須） -->
    <uuid>7066fe49-ea37-46af-942b-64a9280bda27</uuid>
    <!-- creator, vendor, owner, date が欠落（lenientでは警告） -->
  </document>
  <protocol id="protocol-001">
    <uuid>38c8e79c-603d-4cc1-aed2-50b4470062a9</uuid>
    <method>
      <!-- id属性が欠落 -->
      <uuid>42dd5831-1498-4a4e-99a6-658ee26002a5</uuid>
      <pnml id="pnml-001">
        <uuid>cc23e273-cce6-4a38-ae3d-23e1614f522f</uuid>
        <place id="place-001">
          <position x="100" y="100"/>
        </place>
        <transition id="transition-001">
          <position x="200" y="100"/>
        </transition>
        <arc id="arc-001" source="place-001" target="transition-001">
        </arc>
      </pnml>
      <program id="program-001">
        <uuid>88f2d18a-e287-475d-8a2f-4ae7b5cfb117</uuid>
        <instruction id="instruction-001">
          <uuid>01f835ab-b4be-4926-b766-c192b132d16e</uuid>
          <transitionRef id="tref-001" ref="transition-001"/>
        </instruction>
      </program>
    </method>
  </protocol>
</maiml>
