{
  "name": "mmdpf",
  "version": "1.0.0",
  "description": "マルチモーダルデータプラットフォーム",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node tests/e2e/scripts/run-e2e.js",
    "test:ui": "node tests/e2e/scripts/run-e2e-ui.js",
    "test:grep": "npx bddgen --config tests/e2e/playwright.config.ts && npx playwright test --config tests/e2e/playwright.config.ts --headed --grep",
    "e2e:gen-feature": "npx ts-node --project tsconfig.json tests/e2e/scripts/md-to-feature.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "pg": "^8.19.0",
    "playwright-bdd": "^8.4.2"
  }
}
