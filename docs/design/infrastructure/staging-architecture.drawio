                <mxCell id="ecr" value="Amazon ECR&#xa;137068252939.dkr.ecr.ap-northeast-1&#xa;・mmdpf-backend (タグ: staging)&#xa;・mmdpf-frontend (タグ: staging)&#xa;・mmdpf-nginx (タグ: staging)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=9;" parent="external-services" vertex="1">
                    <mxGeometry x="1000" y="40" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="nat-gw" value="NAT Gateway【新規】&#xa;配置: パブリックサブネット&#xa;(alchemia-public-1a)&#xa;・アプリ層プライベートサブネットから&#xa;　インターネットへの送信トラフィックを中継&#xa;　（ECRイメージ取得 / API通信等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=9;fontStyle=1;" parent="external-services" vertex="1">
                    <mxGeometry x="1300" y="40" width="280" height="110" as="geometry"/>
                </mxCell>

                <!-- ======== 矢印: 既存フロー ======== -->
                <!-- ユーザー(mTLS) → NLB -->
                <mxCell id="arrow-user-nlb" value="TCP/443&#xa;TCPパススルー" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#0000FF;fontColor=#0000FF;fontSize=9;" parent="1" source="user-https" target="nlb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- ユーザー(HTTP) → 既存ALB -->
                <mxCell id="arrow-user-alb-existing" value="HTTP/80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0000FF;fontColor=#0000FF;fontSize=9;" parent="1" source="user-http" target="alb-existing" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- NLB → nginx -->
                <mxCell id="arrow-nlb-nginx" value="TCP/443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#FF8000;fontColor=#FF8000;fontSize=9;" parent="1" source="nlb" target="ecs-nginx-service" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- 既存ALB → nginx -->
                <mxCell id="arrow-alb-existing-nginx" value="HTTP/80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;strokeColor=#FF8000;fontColor=#FF8000;fontSize=9;" parent="1" source="alb-existing" target="ecs-nginx-service" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- nginx → backend (Service Discovery) -->
                <mxCell id="arrow-nginx-backend" value="TCP/3001&#xa;Service Discovery&#xa;alchemia-backend.alchemia.local" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6600CC;fontColor=#6600CC;fontSize=9;" parent="1" source="ecs-nginx-service" target="ecs-backend-service" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- ======== 矢印: 新規フロー ======== -->
                <!-- ユーザー(新規HTTPS) → 新規ALB -->
                <mxCell id="arrow-user-alb-new" value="HTTPS/443&#xa;(HTTP→HTTPSリダイレクト)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;strokeColor=#007700;fontColor=#007700;fontSize=9;fontStyle=1;" parent="1" source="user-https-new" target="alb-new" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- 新規ALB → frontend ECS (アプリ層プライベート) -->
                <mxCell id="arrow-alb-new-frontend" value="/* → frontend-tg&#xa;HTTP/3000【新規】" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#007700;fontColor=#007700;fontSize=9;fontStyle=1;" parent="1" source="alb-new" target="ecs-frontend-service" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- 新規ALB → backend ECS -->
                <mxCell id="arrow-alb-new-backend" value="/api/* → backend-tg&#xa;HTTP/3001【新規】" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#007700;fontColor=#007700;fontSize=9;fontStyle=1;" parent="1" source="alb-new" target="ecs-backend-service" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- 新規ALB → ACM (SSL証明書参照) -->
                <mxCell id="arrow-alb-new-acm" value="SSL証明書参照" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#007700;fontSize=9;dashed=1;" parent="1" source="alb-new" target="acm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- frontend ECS → NAT Gateway（ECRアクセス等） -->
                <mxCell id="arrow-frontend-nat" value="外部通信&#xa;(ECR/API)&#xa;NAT GW経由" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#007700;fontColor=#007700;fontSize=9;dashed=1;fontStyle=1;" parent="1" source="ecs-frontend-service" target="nat-gw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- ======== 矢印: backend → DB/Cache/外部 ======== -->
                <mxCell id="arrow-backend-aurora" value="TCP/5432 (SSL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0066CC;fontColor=#0066CC;fontSize=9;" parent="1" source="ecs-backend-service" target="aurora-1a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-backend-redis" value="TCP/6379 (TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#009900;fontColor=#009900;fontSize=9;" parent="1" source="ecs-backend-service" target="redis-1a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-backend-s3" value="IAM ロール&#xa;(S3アクセス)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;" parent="1" source="ecs-backend-service" target="s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-backend-bedrock" value="IAM ロール&#xa;(Bedrockアクセス)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;" parent="1" source="ecs-backend-service" target="bedrock" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-backend-ssm" value="IAM ロール&#xa;(SSMアクセス)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;" parent="1" source="ecs-backend-service" target="ssm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-backend-ecr" value="イメージ取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;" parent="1" source="ecs-backend-service" target="ecr" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- ======== 凡例エリア ======== -->
                <mxCell id="sg-legend" value="【セキュリティグループ構成】&#xa;【既存】&#xa;■ sg-0b315366936dbbf03 (既存ALB用): TCP/80,443 ← 0.0.0.0/0&#xa;■ sg-08569630d4e399b60 (nginx-sg): TCP/80,443 ← 0.0.0.0/0 ⚠️全開放&#xa;■ sg-0920f1a670e75b444 (backend-sg): TCP/3001 ← nginx-sg のみ&#xa;■ sg-02d0638a1a2185f47 (rds-sg): TCP/5432 ← backend-sg のみ&#xa;■ sg-0e21f75613471063b (redis-sg): TCP/6379 ← backend-sg のみ&#xa;━━━━━━━━━━━━━━━━━&#xa;【新規追加】&#xa;■ prod-alb-sg: TCP/80,443 ← 0.0.0.0/0&#xa;■ prod-frontend-sg: TCP/3000 ← prod-alb-sg のみ&#xa;※ backend-sg 追加変更: TCP/3001 ← prod-alb-sg も許可&#xa;&#xa;⚠️ = 要対応  ✅ = 設定済み" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="280" width="460" height="275" as="geometry"/>
                </mxCell>
                <mxCell id="alb-routing-legend" value="【新規ALB ルーティングルール】&#xa;1. HTTP/80 → HTTPS/443 リダイレクト&#xa;2. HTTPS/443 パスベースルール:&#xa;　 /api/* → backend-tg (TCP:3001)&#xa;　 /* (default) → frontend-tg (TCP:3000)&#xa;ヘルスチェック:&#xa;　 frontend-tg: GET / → 200&#xa;　 backend-tg: GET /api/health → 200" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="575" width="460" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="subnet-legend" value="【サブネット構成（レイヤー分離）】&#xa;━━━━━━━━━━━━━━━━━&#xa;【パブリック層】（既存）&#xa;　alchemia-public-1a: 10.1.1.0/24&#xa;　alchemia-public-1c: 10.1.2.0/24&#xa;　→ ALB, NLB, nginx ECS, backend ECS&#xa;━━━━━━━━━━━━━━━━━&#xa;【アプリ層プライベート】（新規追加）&#xa;　prod-app-private-1a: 10.1.21.0/24&#xa;　prod-app-private-1c: 10.1.22.0/24&#xa;　→ frontend ECS（prod-frontend-service）&#xa;━━━━━━━━━━━━━━━━━&#xa;【データ層プライベート】（既存）&#xa;　alchemia-private-1a: 10.1.11.0/24&#xa;　alchemia-private-1c: 10.1.12.0/24&#xa;　→ Aurora / Redis / 踏み台 EC2" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="755" width="460" height="295" as="geometry"/>
                </mxCell>
                <mxCell id="diff-legend" value="【新規追加要素のまとめ】&#xa;✅ 新規 ALB（HTTPS/443 + HTTP→HTTPSリダイレクト）&#xa;✅ アプリ層プライベートサブネット (1a: 10.1.21.0/24, 1c: 10.1.22.0/24)&#xa;✅ 新規 frontend ECS サービス（アプリ層サブネット配置）&#xa;✅ ACM 証明書（新規ALB用 SSL/TLS）&#xa;✅ NAT Gateway（アプリ層→インターネット通信用）&#xa;━━━━━━━━━━━━━━━━━&#xa;【既存要素（変更なし）】&#xa;　・NLB（TCP/443 TCPパススルー）&#xa;　・既存 ALB（HTTP/80、?orgId= クエリ）&#xa;　・nginx ECS サービス（mTLS終端・proxy）&#xa;　・backend ECS サービス&#xa;　・データ層: Aurora / Redis / 踏み台 EC2" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="1070" width="460" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="sd-legend" value="【Service Discovery（既存）】&#xa;名前空間: alchemia.local&#xa;ID: ns-qpfu4ddhzvys7xqb&#xa;backend DNS:&#xa;alchemia-backend.alchemia.local" style="text;html=1;strokeColor=#6600CC;fillColor=#f3e8ff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="1360" width="460" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="secret-warning" value="【⚠️ シークレット管理 警告】&#xa;ECS タスク定義 JSON に平文記述 ⚠️&#xa;DB_PASSWORD, JWT_SECRET, SESSION_SECRET&#xa;REDIS_PASSWORD 等&#xa;Secrets Manager への移行: 未実施 ⚠️" style="text;html=1;strokeColor=#FF0000;fillColor=#FFCCCC;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="2220" y="1480" width="460" height="95" as="geometry"/>
