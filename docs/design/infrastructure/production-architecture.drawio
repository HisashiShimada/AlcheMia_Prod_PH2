                    <mxGeometry x="10" y="135" width="380" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="aurora" value="Aurora PostgreSQL  Multi-AZ&#xa;alchemia-production-aurora&#xa;db.r6g.large 以上&#xa;MultiAZ: true&#xa;DeletionProtection: 有効&#xa;BackupRetentionPeriod: 7日以上&#xa;SG: alchemia-aurora-sg&#xa;TCP:5432 ← backend-sg のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=9;" parent="vpc" vertex="1">
                    <mxGeometry x="1310" y="500" width="180" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="redis" value="ElastiCache Redis  Multi-AZ&#xa;alchemia-production-redis&#xa;cache.r6g.large&#xa;MultiAZ: 有効&#xa;AutoFailover: 有効&#xa;SnapshotRetentionLimit: 3日以上&#xa;TransitEncryption: 有効&#xa;SG: alchemia-redis-sg&#xa;TCP:6379 ← backend-sg のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;fontSize=9;" parent="vpc" vertex="1">
                    <mxGeometry x="1300" y="280" width="180" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="acm-cert" value="ACM パブリック証明書&#xa;app.your-domain.com&#xa;自動更新 (60日前から)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="130" y="570" width="160" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="external-services" value="外部 AWS サービス（VPC 外のリージョンサービス / VPC Endpoint 経由でプライベートアクセス）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;verticalAlign=top;align=center;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="360" y="1640" width="1500" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="ecr" value="Amazon ECR&#xa;mmdpf-backend  (production)&#xa;mmdpf-frontend  (production)&#xa;mmdpf-nginx リポジトリ廃止&#xa;ecr.api + ecr.dkr Endpoint&#xa;経由でアクセス (採用済み)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=10;" parent="external-services" vertex="1">
                    <mxGeometry x="30" y="45" width="220" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="Amazon S3&#xa;mmdpf-files-production&#xa;バージョニング: 有効&#xa;ライフサイクル設定: 有効&#xa;暗号化 AES256: 有効&#xa;パブリックアクセスブロック: 有効&#xa;s3 Gateway Endpoint 経由 (採用済み)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=10;fontStyle=1;" parent="external-services" vertex="1">
                    <mxGeometry x="270" y="45" width="220" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="bedrock" value="AWS Bedrock&#xa;AI モデル&#xa;ap-northeast-1&#xa;IAM ロールで認証&#xa;bedrock-runtime Endpoint&#xa;経由でアクセス (採用済み)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=10;" parent="external-services" vertex="1">
                    <mxGeometry x="510" y="45" width="220" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="secrets-manager" value="AWS Secrets Manager&#xa;alchemia/production/*&#xa;  db-password&#xa;  redis-password&#xa;  jwt-secret (64文字以上)&#xa;  session-secret (64文字以上)&#xa;ECS タスク定義 secrets から参照&#xa;VPC Interface Endpoint 経由でアクセス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=10;" parent="external-services" vertex="1">
                    <mxGeometry x="750" y="45" width="220" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="cloudwatch" value="Amazon CloudWatch&#xa;アラーム各種&#xa;ECS / Aurora / Redis / ALB&#xa;の主要メトリクスを監視&#xa;VPC Interface Endpoint 経由でアクセス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=10;" parent="external-services" vertex="1">
                    <mxGeometry x="990" y="45" width="220" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sg-legend" value="セキュリティグループ構成&#xa;&#xa;alchemia-alb-sg  (ALB用)&#xa;  インバウンド: TCP:443 ← 0.0.0.0/0&#xa;&#xa;alchemia-backend-sg  (backend ECSタスク用)&#xa;  インバウンド: TCP:3001 ← alchemia-alb-sg のみ&#xa;&#xa;alchemia-frontend-sg  (frontend ECSタスク用)&#xa;  インバウンド: TCP:3000 ← alchemia-alb-sg のみ&#xa;&#xa;alchemia-aurora-sg  (Aurora用)&#xa;  インバウンド: TCP:5432 ← alchemia-backend-sg のみ&#xa;&#xa;alchemia-redis-sg  (ElastiCache用)&#xa;  インバウンド: TCP:6379 ← alchemia-backend-sg のみ&#xa;&#xa;alchemia-vpce-sg  (VPC Endpoint用)&#xa;  インバウンド: TCP:443 ← backend-sg / frontend-sg" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1950" y="560" width="380" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="diff-legend" value="検証環境 → 本番環境  主な変更点&#xa;&#xa;NLB 廃止 → ALB (mTLS verify) に変更&#xa;nginx コンテナ廃止&#xa;frontend を独立サービスに分離 (新規)&#xa;desiredCount: 1 → 2以上&#xa;Circuit Breaker: 無効 → 有効&#xa;Secrets Manager でシークレット管理&#xa;AWS WAF を ALB にアタッチ&#xa;Route 53 + 独自ドメイン設定&#xa;Aurora: SingleAZ/t3.medium → MultiAZ/r6g.large&#xa;Redis: SingleAZ → MultiAZ/AutoFailover&#xa;S3 バージョニング有効化&#xa;CloudWatch アラーム設定&#xa;★ VPC Interface Endpoint 採用 (新規)&#xa;  ECR/Bedrock/Secrets Manager/Logs を&#xa;  PrivateLink 経由でアクセス" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1950" y="880" width="380" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="vpc-endpoint-note" value="【VPC Endpoint (PrivateLink) 採用済み】&#xa;&#xa;ECR・Bedrock・S3 へのアクセスは&#xa;すべて VPC Endpoint 経由でプライベート接続:&#xa;&#xa;・ecr.api   (Interface) ← ECR API&#xa;・ecr.dkr   (Interface) ← ECR イメージpull&#xa;・s3         (Gateway)  ← ECRレイヤー/S3データ&#xa;・bedrock-runtime (Interface) ← AI推論&#xa;・secretsmanager (Interface) ← シークレット取得&#xa;・logs        (Interface) ← CloudWatch Logs&#xa;&#xa;インターネット経由を排除し&#xa;通信は AWS バックボーン内で完結。&#xa;NAT Gateway は不要。" style="text;html=1;strokeColor=#9673a6;fillColor=#f3e8ff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1950" y="1170" width="380" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="mtls-flow" value="mTLS 認証フロー&#xa;&#xa;1. ブラウザが HTTPS:443 に接続&#xa;   クライアント証明書 .p12 を提示&#xa;&#xa;2. ALB がサーバー証明書を提示 (ACM)&#xa;   ブラウザが CA証明書でサーバー証明書を検証&#xa;&#xa;3. ALB が ACM Trust Store (ca.crt) でクライアント証明書を検証&#xa;   検証成功 → 4へ進む&#xa;   検証失敗 → 400 エラーを返す&#xa;&#xa;4. ALB が Subject ヘッダーを backend へ付与&#xa;   X-Amzn-Mtls-Clientcert-Subject:&#xa;   CN=b6ae9356-...,O=MMDPF,...&#xa;&#xa;5. backend が CN を解析 → organization_id として使用&#xa;&#xa;backend SG は alb-sg からのみ通信を許可&#xa;直接アクセス・ヘッダー偽装を防止" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1950" y="1470" width="380" height="270" as="geometry"/>
