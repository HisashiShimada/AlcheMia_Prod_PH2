                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-waf-alb" value="ALBにアタッチ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b85450;fontColor=#b85450;fontSize=9;dashed=1;endArrow=open;endFill=0;" parent="1" source="waf" target="alb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="arrow-acmcert-alb" value="ALBにアタッチ (TLS終端)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;dashed=1;endArrow=open;endFill=0;" parent="1" source="acm-cert" target="alb" edge="1">
